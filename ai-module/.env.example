# Backend API base URL
API_BASE_URL=http://localhost:5000/api

# The tracker authenticates as a city manager (the "on-site device" identity).
# This must be an existing citymanager account that manages the city this board belongs to.
MANAGER_EMAIL=REPLACE_WITH_MANAGER_EMAIL
MANAGER_PASSWORD=REPLACE_WITH_MANAGER_PASSWORD

# IDs for the specific board/timeslot/reservation this webcam demo represents.
# Get these from MongoDB Compass or by calling the relevant GET endpoints.
BOARD_ID=REPLACE_WITH_BOARD_ID
TIMESLOT_ID=REPLACE_WITH_TIMESLOT_ID
RESERVATION_ID=REPLACE_WITH_RESERVATION_ID

# One of: webcam | video_file | youtube_live
SOURCE_TYPE=webcam

# Used when SOURCE_TYPE=webcam
CAMERA_INDEX=0

# Used when SOURCE_TYPE=video_file
VIDEO_FILE_PATH=sample_videos/clip.mp4

# Used when SOURCE_TYPE=youtube_live
YOUTUBE_URL=REPLACE_WITH_YOUTUBE_URL

# How often to send aggregated counts to the backend (seconds)
REPORT_INTERVAL_SECONDS=30

# Minimum detection confidence (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.4
